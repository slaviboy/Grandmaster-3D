{
  "name": "grandmaster-3d",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D chess game in the browser with wooden Staunton pieces modeled in Blender and a Stockfish opponent.",
  "license": "GPL-3.0-or-later",
  "author": "Stanislav Georgiev (https://github.com/slaviboy)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run tests/architecture",
    "test:e2e": "playwright test",
    "models": "node scripts/build-models.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
